// Empty application, see design/empty-state.md.

import { Theme } from "theme.slint";
import { AppButton, ButtonKind } from "widgets.slint";

export component EmptyState {
    callback create();

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            VerticalLayout {
                width: min(420px, root.width - 48px);
                padding-bottom: 40px;

                HorizontalLayout {
                    alignment: start;
                    Image {
                        source: @image-url("icons/box.svg");
                        colorize: Theme.tx3;
                        width: 24px;
                        height: 24px;
                        accessible-role: none;
                    }
                }

                Rectangle {
                    height: 14px;
                }

                Text {
                    text: "Create an instance to run an AI agent with controlled file and network access.";
                    wrap: word-wrap;
                    font-size: Theme.font-dialog;
                    color: Theme.tx;
                }

                Rectangle {
                    height: 22px;
                }

                HorizontalLayout {
                    alignment: start;
                    AppButton {
                        kind: ButtonKind.primary;
                        text: "Create instance";
                        icon: @image-url("icons/plus.svg");
                        clicked => {
                            root.create();
                        }
                    }
                }
            }
        }
    }
}
