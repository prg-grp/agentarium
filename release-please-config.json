{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "agentarium",
      "initial-version": "1.0.0",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true }
      ],
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='app')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='command_plane')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='data_plane')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='guest_observer')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='guest_observer_common')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='guest_observer_ebpf')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='guest_supervisor')].version" }
      ]
    }
  }
}
