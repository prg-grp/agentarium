// Data types shared between Rust and the UI. Re-exported from app-window.slint.

export enum Tone { ok, warn, bad, neutral, muted, accent }

export enum InstanceState { running, agent-exited, maintenance, startup-failed, stopped, draft }

export enum InstanceAction { start, stop, boot-maintenance, restart-maintenance, delete }

export struct StatusReading {
    value: string,
    tone: Tone,
}

export struct InstanceItem {
    id: string,
    name: string,
    agent: string,
    state: InstanceState,
    summary: string,
    vm: StatusReading,
    agent-status: StatusReading,
    monitoring: StatusReading,
    pending-changes: int,
    has-terminal: bool,
}

// One styled stretch of terminal text, starting at column `col`.
export struct TermRun {
    col: int,
    width: int,
    text: string,
    fg: color,
    bg: color,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct TermLine {
    runs: [TermRun],
}

// Selected cells on one visible row.
export struct TermSpan {
    row: int,
    col: int,
    width: int,
}
