[Unit]
Description=Run the instance's provisioning script
ConditionKernelCommandLine=agent_toolbox.mode=provision
After=systemd-networkd.service clock-from-host.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agent-toolbox-provision
StandardInput=null
StandardOutput=tty
StandardError=tty
TTYPath=/dev/hvc0

[Install]
WantedBy=multi-user.target
