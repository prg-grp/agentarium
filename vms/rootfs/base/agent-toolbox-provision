#!/bin/sh
# Provision mode (kernel flag agent_toolbox.mode=provision): runs the instance's provisioning
# script as root. The app shares a folder holding provision.sh; the script's exit code goes
# to status in that folder, which the app reads once the VM has powered off.
dir=/run/agent-toolbox/provision
mkdir -p "$dir"
if mount -t virtiofs agent-toolbox-provision "$dir"; then
    echo "Running the provisioning script."
    (cd /root && bash "$dir/provision.sh")
    code=$?
    echo "$code" > "$dir/status"
    sync
    echo "Provisioning script exited with $code. Powering off."
else
    echo "Couldn't mount the provisioning folder. Powering off."
fi
systemctl --no-block poweroff
