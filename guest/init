#!/bin/sh
# PID 1 of the demo VM: mount the basics, then keep a shell open on the
# virtio console (/dev/hvc0), which the app shows in its Terminal tab.

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
exec </dev/console >/dev/console 2>&1

hostname demo-vm
export HOME=/root TERM=xterm-256color PS1='demo-vm:\w# '
echo "Agent Toolbox demo VM ready."

# A new shell starts whenever the previous one exits, so PID 1 never exits.
# Use `poweroff -f` to stop the VM.
while true; do
    setsid -c /bin/sh -l <>/dev/hvc0 >&0 2>&1
done
