// Configuration fields shared by the creation flow and the Settings tab: launch, environment,
// shared folders, network and resources. Each block shows what its owner passes in and reports
// every edit through a callback; the owner (src/create.rs, src/settings.rs) checks it.

import { LineEdit, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EnvRow, MountRow, LayoutRow, RuleRow, ForwardRow } from "types.slint";
import { AppButton, ButtonKind, SegmentedControl } from "widgets.slint";

export component Link {
    in property <string> text;
    callback clicked();

    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        Text {
            text: root.text;
            color: touch.has-hover ? Theme.acc.brighter(15%) : Theme.acc;
            font-size: Theme.font-small;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Single-line input; `invalid` outlines it in `bad`.
export component Field {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> mono;
    in property <bool> invalid;
    in property <bool> read-only;
    out property <bool> has-focus: edit.has-focus;
    callback edited(text: string);
    callback accepted(text: string);

    forward-focus: edit;

    // Focuses the field with the cursor after the last character.
    public function focus-at-end() {
        edit.focus();
        // Byte offsets; anything past the end is clamped to it, and a character has at most 4.
        edit.set-selection-offsets(edit.text.character-count * 4, edit.text.character-count * 4);
    }

    HorizontalLayout {
        edit := LineEdit {
            text <=> root.text;
            read-only: root.read-only;
            placeholder-text: root.placeholder;
            font-family: root.mono ? Theme.mono : "";
            font-size: root.mono ? Theme.font-mono : Theme.font-body;
            accessible-label: root.label != "" ? root.label : root.placeholder;
            edited(text) => {
                root.edited(text);
            }
            accepted(text) => {
                root.accepted(text);
            }
        }
    }

    if root.invalid: Rectangle {
        border-width: 1px;
        border-color: Theme.bad;
        border-radius: 4px;
    }
}

// An icon and a sentence below a field; extra children (a link) follow the sentence.
export component Message {
    in property <image> icon;
    in property <string> text;
    in property <color> color;

    HorizontalLayout {
        spacing: 6px;

        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Image {
                source: root.icon;
                colorize: root.color;
                width: 15px;
                height: 15px;
                accessible-role: none;
            }
        }

        Text {
            text: root.text;
            color: root.color;
            font-size: Theme.font-small;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        @children
    }
}

// A field's label, above it.
component Label inherits Text {
    color: Theme.tx2;
    font-size: Theme.font-small;
}

// The Allowed or Denied list.
component RuleList {
    in property <bool> deny;
    in property <[RuleRow]> rows;
    // Returns why the entry was refused, or "" once it is added.
    callback add-rule(text: string) -> string;
    callback toggle-scope(index: int);
    callback remove-rule(index: int);
    property <string> error;

    horizontal-stretch: 1;

    VerticalLayout {
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.deny ? @image-url("icons/ban.svg") : @image-url("icons/circle-check.svg");
                    colorize: root.deny ? Theme.bad : Theme.ok;
                    width: 16px;
                    height: 16px;
                    accessible-role: none;
                }
            }

            Text {
                text: root.deny ? "Denied" : "Allowed";
                color: Theme.tx;
                font-weight: Theme.weight-medium;
            }
        }

        for row[index] in root.rows: VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: row.target;
                    color: Theme.tx;
                    font-family: Theme.mono;
                    font-size: Theme.font-mono;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Domains toggle between exact name and subdomains; addresses have one scope.
                Rectangle {
                    horizontal-stretch: 0;
                    accessible-role: button;
                    accessible-label: row.scope;
                    accessible-enabled: row.is-domain;
                    accessible-action-default => {
                        if row.is-domain {
                            root.toggle-scope(index);
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: row.scope;
                            color: scope-touch.has-hover && row.is-domain ? Theme.tx : Theme.tx2;
                            font-size: Theme.font-meta;
                            vertical-alignment: center;
                        }
                    }

                    scope-touch := TouchArea {
                        enabled: row.is-domain;
                        mouse-cursor: row.is-domain ? pointer : default;
                        clicked => {
                            root.toggle-scope(index);
                        }
                    }
                }

                AppButton {
                    kind: ButtonKind.ghost;
                    compact: true;
                    icon: @image-url("icons/x.svg");
                    label: "Remove " + row.target;
                    clicked => {
                        root.remove-rule(index);
                    }
                }
            }

            if row.conflict != "": Message {
                icon: @image-url("icons/arrows-cross.svg");
                color: Theme.warn;
                text: row.conflict;
            }
        }

        Field {
            mono: true;
            placeholder: root.deny ? "Add a domain or address to deny" : "Add a domain or address to allow";
            invalid: root.error != "";
            edited => {
                root.error = "";
            }
            accepted(text) => {
                root.error = root.add-rule(text);
                if root.error == "" {
                    self.text = "";
                }
            }
        }

        if root.error != "": Message {
            icon: @image-url("icons/alert-circle.svg");
            color: Theme.bad;
            text: root.error;
        }
    }
}

// Command, arguments and working directory.
export component LaunchFields {
    in-out property <string> command;
    in-out property <string> working-directory;
    in property <[string]> arguments;
    in property <bool> command-read-only;
    // Shown beside a read-only command, like "Set by the Claude Code preset."
    in property <string> command-note;
    in property <string> command-error;
    in property <string> working-directory-error;
    callback set-command(command: string);
    callback add-argument(argument: string);
    callback remove-argument(index: int);
    // An empty argument removes it.
    callback edit-argument(index: int, argument: string);
    callback move-argument(from: int, to: int);
    callback set-working-directory(directory: string);
    // The argument being edited, or -1.
    property <int> editing: -1;
    // While an argument is dragged by its grip: its index (-1 otherwise), the pointer in window
    // coordinates, the pill under the pointer, and the slot (0 to the count) it would go to.
    property <int> drag-from: -1;
    property <length> pointer-x;
    property <length> pointer-y;
    property <int> drop-pill: -1;
    property <int> drop-slot: -1;
    property <bool> pointer-inside: root.pointer-x >= pills.absolute-position.x && root.pointer-x < pills.absolute-position.x + pills.width && root.pointer-y >= pills.absolute-position.y && root.pointer-y < pills.absolute-position.y + pills.height;
    // Dropping now would change the order.
    property <bool> drop-moves: root.drag-from >= 0 && root.pointer-inside && root.drop-slot >= 0 && root.drop-slot != root.drag-from && root.drop-slot != root.drag-from + 1;

    function end-drag(drop: bool) {
        if drop && root.drop-moves {
            root.move-argument(root.drag-from, root.drop-slot > root.drag-from ? root.drop-slot - 1 : root.drop-slot);
        }
        root.drag-from = -1;
        root.drop-pill = -1;
        root.drop-slot = -1;
    }

    // Ends editing once, whether by Return or by focus leaving the field.
    function commit-argument(index: int, text: string) {
        if root.editing == index {
            root.editing = -1;
            root.edit-argument(index, text);
        }
    }

    VerticalLayout {
        spacing: 14px;

        VerticalLayout {
            spacing: 6px;

            Label {
                text: "Command";
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                Field {
                    width: 200px;
                    mono: true;
                    label: "Command";
                    text <=> root.command;
                    read-only: root.command-read-only;
                    invalid: root.command-error != "";
                    edited(text) => {
                        root.set-command(text);
                    }
                }

                if root.command-error != "": VerticalLayout {
                    alignment: center;
                    Message {
                        icon: @image-url("icons/alert-circle.svg");
                        color: Theme.bad;
                        text: root.command-error;
                    }
                }

                if root.command-note != "": Text {
                    text: root.command-note;
                    color: Theme.tx2;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 6px;

            Label {
                text: "Arguments";
            }

            pills := FlexboxLayout {
                spacing: 6px;

                for argument[index] in root.arguments: HorizontalLayout {
                    if root.editing == index: Field {
                        // Menlo is monospaced, so the argument's length gives its width; Fluent's
                        // LineEdit is never narrower than 160px.
                        width: max(180px, argument.character-count * Theme.font-mono * 0.62 + 40px);
                        mono: true;
                        label: "Argument";
                        text: argument;
                        init => {
                            self.focus-at-end();
                        }
                        accepted(text) => {
                            root.commit-argument(index, text);
                        }
                        changed has-focus => {
                            if !self.has-focus {
                                root.commit-argument(index, self.text);
                            }
                        }
                    }

                    if root.editing != index: Rectangle {
                        property <bool> dragged: root.drag-from == index;
                        // Widened by half the spacing, so the gaps between pills count too.
                        property <bool> under-pointer: root.drag-from >= 0 && root.pointer-x >= self.absolute-position.x - 3px && root.pointer-x < self.absolute-position.x + self.width + 3px && root.pointer-y >= self.absolute-position.y - 3px && root.pointer-y < self.absolute-position.y + self.height + 3px;
                        property <bool> right-half: root.pointer-x >= self.absolute-position.x + self.width / 2;

                        function aim() {
                            if self.under-pointer {
                                root.drop-pill = index;
                                root.drop-slot = self.right-half ? index + 1 : index;
                            }
                        }
                        changed under-pointer => {
                            self.aim();
                        }
                        changed right-half => {
                            self.aim();
                        }

                        min-height: add-field.preferred-height;
                        border-radius: 4px;
                        background: dragged ? Theme.acc.transparentize(85%) : pill-touch.has-hover && root.drag-from < 0 ? Theme.hover : Theme.raise;
                        border-width: dragged ? 1px : 0px;
                        border-color: Theme.acc;

                        pill-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.editing = index;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 2px;
                            spacing: 6px;

                            // Only the grip starts a drag, so the text stays clickable. It keeps
                            // the mouse until release, and with it the cursor.
                            TouchArea {
                                width: 16px;
                                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                moved => {
                                    if self.pressed {
                                        root.drag-from = index;
                                        root.pointer-x = self.absolute-position.x + self.mouse-x;
                                        root.pointer-y = self.absolute-position.y + self.mouse-y;
                                    }
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.up {
                                        root.end-drag(true);
                                    } else if event.kind == PointerEventKind.cancel {
                                        root.end-drag(false);
                                    }
                                }

                                Image {
                                    x: 1px;
                                    y: (parent.height - self.height) / 2;
                                    width: 14px;
                                    height: 14px;
                                    source: @image-url("icons/grip-vertical.svg");
                                    colorize: Theme.tx3;
                                    accessible-role: none;
                                }
                            }

                            Text {
                                text: argument;
                                color: dragged ? Theme.tx2 : Theme.tx;
                                font-family: Theme.mono;
                                font-size: Theme.font-mono;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                AppButton {
                                    kind: ButtonKind.ghost;
                                    compact: true;
                                    icon: @image-url("icons/x.svg");
                                    label: "Remove argument " + argument;
                                    clicked => {
                                        root.remove-argument(index);
                                    }
                                }
                            }
                        }

                        // Where the dragged argument would land: before or after this pill.
                        if root.drop-moves && root.drop-pill == index && (root.drop-slot == index || root.drop-slot == index + 1): Rectangle {
                            x: root.drop-slot == index ? -4px : parent.width + 2px;
                            y: 0;
                            width: 2px;
                            height: parent.height;
                            border-radius: 1px;
                            background: Theme.acc;
                        }
                    }
                }

                add-field := Field {
                    // Over this field, the dragged argument goes to the end.
                    property <bool> under-pointer: root.drag-from >= 0 && root.pointer-x >= self.absolute-position.x - 3px && root.pointer-x < self.absolute-position.x + self.width && root.pointer-y >= self.absolute-position.y - 3px && root.pointer-y < self.absolute-position.y + self.height + 3px;
                    changed under-pointer => {
                        if self.under-pointer {
                            root.drop-pill = root.arguments.length - 1;
                            root.drop-slot = root.arguments.length;
                        }
                    }

                    width: 180px;
                    mono: true;
                    placeholder: "Add argument";
                    accepted(text) => {
                        root.add-argument(text);
                        self.text = "";
                        self.focus();
                    }
                }
            }

            Text {
                text: "Press Return to add. Click an argument to change it, or drag it to reorder. Each argument is passed as it is, without shell quoting.";
                color: Theme.tx3;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            spacing: 6px;

            Label {
                text: "Working directory inside the instance";
            }

            HorizontalLayout {
                alignment: start;
                Field {
                    width: 360px;
                    mono: true;
                    label: "Working directory inside the instance";
                    text <=> root.working-directory;
                    invalid: root.working-directory-error != "";
                    edited(text) => {
                        root.set-working-directory(text);
                    }
                }
            }

            if root.working-directory-error != "": Message {
                icon: @image-url("icons/alert-circle.svg");
                color: Theme.bad;
                text: root.working-directory-error;
            }

            Text {
                text: "~/workspace is on the instance's own disk. Shared folders go below it by default.";
                color: Theme.tx3;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

// The environment variables and "Add variable".
export component EnvironmentFields {
    in property <[EnvRow]> rows;
    callback add();
    callback edit(index: int, name: string, value: string);
    callback remove-row(index: int);

    VerticalLayout {
        spacing: 14px;

        for row[index] in root.rows: VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 8px;

                Field {
                    width: 200px;
                    mono: true;
                    label: "Variable name";
                    placeholder: "NAME";
                    text: row.name;
                    invalid: row.error != "";
                    edited(text) => {
                        root.edit(index, text, row.value);
                    }
                }

                Field {
                    horizontal-stretch: 1;
                    mono: true;
                    label: "Value of " + row.name;
                    placeholder: "value";
                    text: row.value;
                    edited(text) => {
                        root.edit(index, row.name, text);
                    }
                }

                VerticalLayout {
                    alignment: center;
                    AppButton {
                        kind: ButtonKind.ghost;
                        icon: @image-url("icons/x.svg");
                        label: "Remove variable";
                        clicked => {
                            root.remove-row(index);
                        }
                    }
                }
            }

            if row.error != "": Message {
                icon: @image-url("icons/alert-circle.svg");
                color: Theme.bad;
                text: row.error;
            }
        }

        HorizontalLayout {
            alignment: start;
            AppButton {
                kind: ButtonKind.ghost;
                icon: @image-url("icons/plus.svg");
                text: "Add variable";
                clicked => {
                    root.add();
                }
            }
        }
    }
}

// The shared folders table; "Add folder" is the owner's.
export component FolderTable {
    in property <[MountRow]> rows;
    in property <[LayoutRow]> layout;
    callback choose-folder(index: int);
    callback edit-guest-path(index: int, path: string);
    callback set-writable(index: int, writable: bool);
    callback remove-row(index: int);

    VerticalLayout {
        if root.rows.length == 0: Text {
            text: "No folders are shared. That's fine if you don't need the results on your Mac right away: the agent's work stays on the instance's disk, and you can share a folder later.";
            color: Theme.tx3;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }

        if root.rows.length > 0: HorizontalLayout {
            spacing: 16px;
            padding-bottom: 8px;

            Text {
                horizontal-stretch: 1;
                text: "On your Mac";
                color: Theme.tx3;
                font-size: Theme.font-meta;
            }

            Text {
                width: 300px;
                text: "Inside the instance";
                color: Theme.tx3;
                font-size: Theme.font-meta;
            }

            Text {
                width: 200px;
                text: "Access";
                color: Theme.tx3;
                font-size: Theme.font-meta;
            }

            Rectangle {
                width: 32px;
            }
        }

        for row[index] in root.rows: VerticalLayout {
            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: row.host-path;
                            color: row.missing ? Theme.tx3 : Theme.tx;
                            font-family: Theme.mono;
                            font-size: Theme.font-mono;
                            wrap: word-wrap;
                        }
                    }

                    Field {
                        width: 300px;
                        mono: true;
                        label: "Path inside the instance";
                        text: row.guest-path;
                        invalid: row.guest-error != "";
                        edited(text) => {
                            root.edit-guest-path(index, text);
                        }
                    }

                    HorizontalLayout {
                        width: 200px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            SegmentedControl {
                                options: ["Read only", "Read and write"];
                                selected: row.writable ? 1 : 0;
                                changed(option) => {
                                    root.set-writable(index, option == 1);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        AppButton {
                            kind: ButtonKind.ghost;
                            icon: @image-url("icons/x.svg");
                            label: "Remove folder";
                            clicked => {
                                root.remove-row(index);
                            }
                        }
                    }
                }

                if row.writable: Message {
                    icon: @image-url("icons/alert-triangle.svg");
                    color: Theme.warn;
                    text: "Changes inside this instance modify these host files immediately.";
                }

                if row.problem != "": Message {
                    icon: @image-url("icons/folder-off.svg");
                    color: Theme.bad;
                    text: row.problem;
                    Link {
                        text: "Choose folder";
                        clicked => {
                            root.choose-folder(index);
                        }
                    }
                }

                if row.guest-error != "": Message {
                    icon: @image-url("icons/alert-circle.svg");
                    color: Theme.bad;
                    text: row.guest-error;
                }
            }
        }

        // What the instance sees: ~/workspace on its disk and each valid folder at its path.
        VerticalLayout {
            padding-top: 20px;
            spacing: 6px;

            Text {
                text: "Inside the instance";
                color: Theme.tx3;
                font-size: Theme.font-meta;
            }

            for line in root.layout: HorizontalLayout {
                spacing: 16px;

                // Nested lines are indented; their sources stay aligned.
                HorizontalLayout {
                    width: 280px;
                    padding-left: min(line.depth * 16px, 200px);

                    Text {
                        text: line.path;
                        color: Theme.tx;
                        font-family: Theme.mono;
                        font-size: Theme.font-mono;
                        wrap: char-wrap;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: line.shared ? "← " + line.source : line.source;
                    color: line.shared ? Theme.tx2 : Theme.tx3;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }

            Text {
                text: "A shared folder hides anything the instance already has at that path while it is shared.";
                color: Theme.tx3;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
    }
}

// The default action, access to the Mac and the local network, the Allowed and Denied
// lists, and the ports forwarded from the Mac into the VM.
export component NetworkFields {
    in property <bool> deny;
    in property <bool> allow-local;
    in property <[RuleRow]> allowed;
    in property <[RuleRow]> denied;
    in property <[ForwardRow]> forwards;
    callback set-deny(deny: bool);
    callback set-allow-local(allow: bool);
    // Returns why the entry was refused, or "" once it is added.
    callback add-rule(text: string, deny: bool) -> string;
    callback toggle-scope(deny: bool, index: int);
    callback remove-rule(deny: bool, index: int);
    // The VM's port and the Mac's ("" for a random one); returns why it was refused, or ""
    // once it is added.
    callback add-forward(guest: string, host: string) -> string;
    callback toggle-forward(index: int);
    callback remove-forward(index: int);
    property <string> forward-error;

    function add-forward-fields() {
        root.forward-error = root.add-forward(guest-port.text, host-port.text);
        if root.forward-error == "" {
            guest-port.text = "";
            host-port.text = "";
        }
    }

    VerticalLayout {
        spacing: 24px;
        alignment: start;

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Destinations not listed below";
                font-size: Theme.font-section;
                font-weight: Theme.weight-medium;
                color: Theme.tx;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                SegmentedControl {
                    options: ["Deny", "Allow"];
                    selected: root.deny ? 0 : 1;
                    changed(option) => {
                        root.set-deny(option == 0);
                    }
                }

                Text {
                    text: root.deny ? "The agent can reach only the destinations you allow." : "The agent can reach any destination except the ones you deny.";
                    color: Theme.tx2;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Your Mac and local network";
                font-size: Theme.font-section;
                font-weight: Theme.weight-medium;
                color: Theme.tx;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                SegmentedControl {
                    options: ["Block", "Allow"];
                    selected: root.allow-local ? 1 : 0;
                    changed(option) => {
                        root.set-allow-local(option == 1);
                    }
                }

                Text {
                    text: root.allow-local ? "Local addresses follow the rules. Your Mac is host.internal." : "The agent can't reach your Mac or devices on your network, whatever the rules say.";
                    color: Theme.tx2;
                    vertical-alignment: center;
                }
            }

            if root.allow-local: Message {
                icon: @image-url("icons/alert-triangle.svg");
                color: Theme.warn;
                text: root.deny ? "The agent can reach the local addresses you allow. Allow 192.168.127.1 for services on your Mac." : "The agent can reach services on your Mac and other devices on your network.";
            }
        }

        HorizontalLayout {
            spacing: 28px;

            RuleList {
                deny: false;
                rows: root.allowed;
                add-rule(text) => {
                    return root.add-rule(text, false);
                }
                toggle-scope(index) => {
                    root.toggle-scope(false, index);
                }
                remove-rule(index) => {
                    root.remove-rule(false, index);
                }
            }

            RuleList {
                deny: true;
                rows: root.denied;
                add-rule(text) => {
                    return root.add-rule(text, true);
                }
                toggle-scope(index) => {
                    root.toggle-scope(true, index);
                }
                remove-rule(index) => {
                    root.remove-rule(true, index);
                }
            }
        }

        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Forwarded ports";
                font-size: Theme.font-section;
                font-weight: Theme.weight-medium;
                color: Theme.tx;
            }

            Text {
                text: "Opens a port of the VM on your Mac, for example an agent's web interface. Applies in agent and maintenance mode.";
                color: Theme.tx2;
                wrap: word-wrap;
            }

            for row[index] in root.forwards: VerticalLayout {
                spacing: 4px;

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        horizontal-stretch: 1;
                        text: row.label;
                        color: Theme.tx;
                        font-family: Theme.mono;
                        font-size: Theme.font-mono;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Switches between your Mac only and the local network.
                    Rectangle {
                        horizontal-stretch: 0;
                        accessible-role: button;
                        accessible-label: row.local-network ? "Local network" : "This Mac";
                        accessible-action-default => {
                            root.toggle-forward(index);
                        }

                        HorizontalLayout {
                            Text {
                                text: row.local-network ? "Local network" : "This Mac";
                                color: forward-scope-touch.has-hover ? Theme.tx : Theme.tx2;
                                font-size: Theme.font-meta;
                                vertical-alignment: center;
                            }
                        }

                        forward-scope-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.toggle-forward(index);
                            }
                        }
                    }

                    AppButton {
                        kind: ButtonKind.ghost;
                        compact: true;
                        icon: @image-url("icons/x.svg");
                        label: "Remove forward " + row.label;
                        clicked => {
                            root.remove-forward(index);
                        }
                    }
                }

                if row.local-network: Message {
                    icon: @image-url("icons/alert-triangle.svg");
                    color: Theme.warn;
                    text: "Other devices on your network can reach this port.";
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                guest-port := Field {
                    width: 180px;
                    mono: true;
                    placeholder: "Port in VM";
                    invalid: root.forward-error != "";
                    edited => {
                        root.forward-error = "";
                    }
                    accepted => {
                        root.add-forward-fields();
                    }
                }

                Text {
                    text: "→";
                    color: Theme.tx3;
                    vertical-alignment: center;
                }

                host-port := Field {
                    width: 180px;
                    mono: true;
                    placeholder: "Random";
                    label: "Port on your Mac, empty for a random one";
                    invalid: root.forward-error != "";
                    edited => {
                        root.forward-error = "";
                    }
                    accepted => {
                        root.add-forward-fields();
                    }
                }

                AppButton {
                    text: "Add";
                    kind: ButtonKind.neutral;
                    clicked => {
                        root.add-forward-fields();
                    }
                }
            }

            if root.forward-error != "": Message {
                icon: @image-url("icons/alert-circle.svg");
                color: Theme.bad;
                text: root.forward-error;
            }
        }
    }
}

// Processors, memory and disk, with what the Mac has.
export component ResourceFields {
    in-out property <int> cpus;
    in-out property <int> memory-gb;
    in property <int> max-cpus: 1;
    in-out property <int> disk-gb;
    in property <int> max-memory-gb: 1;
    // The disk can grow, but not shrink below this.
    in property <int> min-disk-gb: 1;
    in property <string> host-line;
    callback set-cpus(cpus: int);
    callback set-memory(gb: int);
    callback set-disk(gb: int);

    VerticalLayout {
        spacing: 14px;

        HorizontalLayout {
            spacing: 24px;
            alignment: start;

            VerticalLayout {
                spacing: 6px;

                Label {
                    text: "Processors";
                }

                SpinBox {
                    width: 120px;
                    minimum: 1;
                    maximum: root.max-cpus;
                    value <=> root.cpus;
                    accessible-label: "Processors";
                    edited(value) => {
                        root.set-cpus(value);
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                Label {
                    text: "Memory (GB)";
                }

                SpinBox {
                    width: 120px;
                    minimum: 1;
                    maximum: root.max-memory-gb;
                    value <=> root.memory-gb;
                    accessible-label: "Memory in GB";
                    edited(value) => {
                        root.set-memory(value);
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;

                Label {
                    text: "Disk (GB)";
                }

                SpinBox {
                    width: 120px;
                    minimum: root.min-disk-gb;
                    maximum: 1024;
                    value <=> root.disk-gb;
                    accessible-label: "Disk in GB";
                    edited(value) => {
                        root.set-disk(value);
                    }
                }
            }
        }

        Text {
            text: root.host-line + " The disk can grow later, but not shrink.";
            color: Theme.tx3;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}
