// Instance creation: harness, agent, shared folders, network, review.
// See design/create-harness.md and the other design/create-*.md files.

import { TextEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PresetRow, EnvRow, MountRow, LayoutRow, RuleRow, ForwardRow, CreateIssue } from "types.slint";
import { AppButton, ButtonKind } from "widgets.slint";
import { Link, Field, Message, LaunchFields, EnvironmentFields, FolderTable, NetworkFields, ResourceFields } from "config-fields.slint";

// The draft being created. Rust (src/create.rs) owns it and checks it after every edit.
export global Creation {
    // The current step (0 harness … 4 review) and the furthest one visited.
    in property <int> step;
    in property <int> reached;

    // Single values, edited in place; every edit is also reported through its callback.
    in-out property <string> name;
    in-out property <string> script;
    in-out property <string> command;
    in-out property <string> working-directory;
    in-out property <int> cpus;
    in-out property <int> memory-gb;
    in-out property <int> disk-gb;

    in property <[PresetRow]> presets;
    // The selected preset, as an index into presets. Only the custom agent's script and
    // command can be edited.
    in property <int> preset;
    in property <bool> is-custom;
    in property <string> preset-name;
    in property <bool> script-changed;
    in property <[string]> arguments;
    in property <[EnvRow]> environment;
    in property <[MountRow]> mounts;
    in property <[LayoutRow]> layout;
    in property <bool> network-deny: true;
    in property <bool> network-allow-local;
    in property <[RuleRow]> allowed;
    in property <[RuleRow]> denied;
    in property <[ForwardRow]> forwards;
    in property <int> max-cpus: 1;
    in property <int> max-memory-gb: 1;
    in property <int> min-disk-gb: 1;
    in property <string> host-line;

    // Validation
    in property <string> name-error;
    in property <string> command-error;
    in property <string> working-directory-error;
    in property <[CreateIssue]> issues;
    in property <bool> can-create;
    in property <bool> can-start;
    in property <string> create-error;

    // Read-back on Review
    in property <string> review-runs;
    in property <string> review-script;
    in property <string> review-allowed;
    in property <string> review-denied;
    in property <string> review-forwards;
    in property <string> review-env;

    callback go(step: int);
    callback cancel();
    // Creates the instance; with start, it also starts right away and provisions.
    callback create(start: bool);
    callback set-name(name: string);
    callback set-preset(index: int);
    callback set-script(script: string);
    callback reset-script();
    callback set-command(command: string);
    callback add-argument(argument: string);
    callback remove-argument(index: int);
    callback edit-argument(index: int, argument: string);
    callback move-argument(from: int, to: int);
    callback set-working-directory(directory: string);
    callback add-env();
    callback edit-env(index: int, name: string, value: string);
    callback remove-env(index: int);
    callback add-folder();
    callback choose-folder(index: int);
    callback edit-guest-path(index: int, path: string);
    callback set-writable(index: int, writable: bool);
    callback remove-folder(index: int);
    callback set-network-deny(deny: bool);
    callback set-network-allow-local(allow: bool);
    // Returns why the entry was refused, or "" once it is added.
    callback add-rule(text: string, deny: bool) -> string;
    callback toggle-scope(deny: bool, index: int);
    callback remove-rule(deny: bool, index: int);
    // The VM's port and the Mac's ("" for a random one); returns why it was refused, or "".
    callback add-forward(guest: string, host: string) -> string;
    callback toggle-forward(index: int);
    callback remove-forward(index: int);
    callback set-cpus(cpus: int);
    callback set-memory(gb: int);
    callback set-disk(gb: int);
}

// Two-column section: title and description on the left, fields on the right.
component Section {
    in property <string> title;
    in property <string> description;
    // Optional link on the right, like "Edit" on Review.
    in property <string> link;
    in property <bool> first;
    callback link-clicked();

    VerticalLayout {
        if !root.first: Rectangle {
            height: 1px;
            background: Theme.line;
        }

        HorizontalLayout {
            padding-top: 22px;
            padding-bottom: 22px;
            spacing: 28px;

            VerticalLayout {
                width: 220px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: root.title;
                    font-size: Theme.font-section;
                    font-weight: Theme.weight-medium;
                    color: Theme.tx;
                    wrap: word-wrap;
                }

                if root.description != "": Text {
                    text: root.description;
                    font-size: Theme.font-small;
                    color: Theme.tx3;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                max-width: 640px;
                horizontal-stretch: 1;
                spacing: 14px;
                alignment: start;
                @children
            }

            if root.link != "": VerticalLayout {
                alignment: start;
                Link {
                    text: root.link;
                    clicked => {
                        root.link-clicked();
                    }
                }
            }
        }
    }
}

component Radio {
    in property <string> label;
    in property <string> note;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-description: root.note;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: root.checked ? Theme.acc : Theme.line2;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.acc;
                    visible: root.checked;
                }
            }
        }

        Text {
            text: root.label;
            color: root.enabled ? Theme.tx : Theme.tx3;
            vertical-alignment: center;
        }

        if root.note != "": Text {
            text: root.note;
            color: Theme.tx3;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component KeyValue {
    in property <string> key;
    in property <string> value;
    in property <bool> mono;

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: 150px;
            text: root.key;
            color: Theme.tx3;
            wrap: word-wrap;
        }

        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.tx;
            wrap: word-wrap;
            font-family: root.mono ? Theme.mono : "";
            font-size: root.mono ? Theme.font-mono : Theme.font-body;
        }
    }
}

export component CreateInstance {
    property <[string]> steps: ["Harness", "Agent", "Shared folders", "Network", "Review"];
    property <[string]> next-steps: ["agent", "shared folders", "network", "review"];

    VerticalLayout {
        // Header and step indicator
        VerticalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 26px;
            padding-bottom: 20px;
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "New instance";
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-medium;
                    color: Theme.tx;
                }

                Text {
                    text: "An instance is a Linux virtual machine on this Mac with its own disk. The agent runs inside it and sees only the folders and domains you allow.";
                    color: Theme.tx2;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 26px;
                alignment: start;

                for name[index] in root.steps: Rectangle {
                    property <bool> current: index == Creation.step;
                    property <bool> done: !current && index < Creation.reached;
                    property <bool> open: !current && index <= Creation.reached;

                    accessible-role: tab;
                    accessible-label: name;
                    accessible-item-selected: current;
                    accessible-action-default => {
                        if open {
                            Creation.go(index);
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: current ? Theme.acc : transparent;
                                border-width: current ? 0px : 1px;
                                border-color: done ? Theme.ok : Theme.line2;

                                if done: Image {
                                    source: @image-url("icons/check.svg");
                                    colorize: Theme.ok;
                                    width: 14px;
                                    height: 14px;
                                    accessible-role: none;
                                }

                                if !done: Text {
                                    text: index + 1;
                                    font-size: Theme.font-meta;
                                    font-weight: Theme.weight-medium;
                                    color: current ? Theme.on-acc : Theme.tx3;
                                }
                            }
                        }

                        Text {
                            text: name;
                            color: current ? Theme.tx : (open ? Theme.tx2 : Theme.tx3);
                            font-weight: current ? Theme.weight-medium : Theme.weight-regular;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: open;
                        mouse-cursor: open ? pointer : default;
                        clicked => {
                            Creation.go(index);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 28px;
                alignment: start;

                // Step 1: harness
                if Creation.step == 0: VerticalLayout {
                    // A preset's script is shown on request, read-only.
                    property <bool> show-script;

                    Section {
                        first: true;
                        title: "Name and harness";
                        description: "The harness is the agent that runs in this instance. A preset installs a known agent and allows the domains it needs.";

                        VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: "Name";
                                color: Theme.tx2;
                                font-size: Theme.font-small;
                            }

                            HorizontalLayout {
                                alignment: start;
                                Field {
                                    width: 320px;
                                    label: "Name";
                                    placeholder: "My fancy agent";
                                    text <=> Creation.name;
                                    invalid: Creation.name-error != "";
                                    edited(text) => {
                                        Creation.set-name(text);
                                    }
                                }
                            }

                            if Creation.name-error != "": Message {
                                icon: @image-url("icons/alert-circle.svg");
                                color: Theme.bad;
                                text: Creation.name-error;
                            }
                        }

                        VerticalLayout {
                            spacing: 10px;

                            Text {
                                text: "Harness";
                                color: Theme.tx2;
                                font-size: Theme.font-small;
                            }

                            for row[index] in Creation.presets: Radio {
                                label: row.name;
                                note: row.note;
                                checked: index == Creation.preset;
                                clicked => {
                                    Creation.set-preset(index);
                                }
                            }
                        }
                    }

                    Section {
                        title: "Provisioning script";
                        description: Creation.is-custom
                            ? "Runs once as root with internet access before the first start. Must be safe to run again."
                            : "Defined by the \{Creation.preset-name} preset. Runs once as root with internet access before the first start. Choose Custom agent to write your own.";

                        if !Creation.is-custom: HorizontalLayout {
                            alignment: start;
                            AppButton {
                                kind: ButtonKind.ghost;
                                compact: true;
                                text: show-script ? "Hide script" : "Show script";
                                clicked => {
                                    show-script = !show-script;
                                }
                            }
                        }

                        if Creation.is-custom || show-script: TextEdit {
                            height: 320px;
                            read-only: !Creation.is-custom;
                            text <=> Creation.script;
                            font-family: Theme.mono;
                            font-size: Theme.font-mono;
                            wrap: no-wrap;
                            accessible-label: "Provisioning script";
                            edited(text) => {
                                Creation.set-script(text);
                            }
                        }

                        if Creation.script-changed: HorizontalLayout {
                            alignment: start;
                            AppButton {
                                kind: ButtonKind.ghost;
                                compact: true;
                                text: "Reset to template";
                                clicked => {
                                    Creation.reset-script();
                                }
                            }
                        }
                    }
                }

                // Step 2: agent
                if Creation.step == 1: VerticalLayout {
                    Section {
                        first: true;
                        title: "Launch";
                        description: "What starts when the instance boots. Runs directly, not through a shell.";

                        LaunchFields {
                            command <=> Creation.command;
                            working-directory <=> Creation.working-directory;
                            arguments: Creation.arguments;
                            command-read-only: !Creation.is-custom;
                            command-note: Creation.is-custom ? "" : "Set by the \{Creation.preset-name} preset.";
                            command-error: Creation.command-error;
                            working-directory-error: Creation.working-directory-error;
                            set-command(command) => {
                                Creation.set-command(command);
                            }
                            add-argument(argument) => {
                                Creation.add-argument(argument);
                            }
                            remove-argument(index) => {
                                Creation.remove-argument(index);
                            }
                            edit-argument(index, argument) => {
                                Creation.edit-argument(index, argument);
                            }
                            move-argument(from, to) => {
                                Creation.move-argument(from, to);
                            }
                            set-working-directory(directory) => {
                                Creation.set-working-directory(directory);
                            }
                        }
                    }

                    Section {
                        title: "Environment variables";
                        description: "Visible to the agent and recorded with each run.";

                        EnvironmentFields {
                            rows: Creation.environment;
                            add => {
                                Creation.add-env();
                            }
                            edit(index, name, value) => {
                                Creation.edit-env(index, name, value);
                            }
                            remove-row(index) => {
                                Creation.remove-env(index);
                            }
                        }
                    }
                }

                // Step 3: shared folders
                if Creation.step == 2: VerticalLayout {
                    padding-top: 22px;
                    spacing: 18px;

                    HorizontalLayout {
                        spacing: 16px;

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Shared folders";
                                font-size: Theme.font-section;
                                font-weight: Theme.weight-medium;
                                color: Theme.tx;
                            }

                            Text {
                                text: "Optional. The agent works in ~/workspace on the instance's own disk. Each folder you share appears at the path you set, and the agent works on your Mac's files there directly. Nothing else on your Mac is shared.";
                                color: Theme.tx2;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            AppButton {
                                text: "Add folder";
                                icon: @image-url("icons/folder-plus.svg");
                                clicked => {
                                    Creation.add-folder();
                                }
                            }
                        }
                    }

                    FolderTable {
                        rows: Creation.mounts;
                        layout: Creation.layout;
                        choose-folder(index) => {
                            Creation.choose-folder(index);
                        }
                        edit-guest-path(index, path) => {
                            Creation.edit-guest-path(index, path);
                        }
                        set-writable(index, writable) => {
                            Creation.set-writable(index, writable);
                        }
                        remove-row(index) => {
                            Creation.remove-folder(index);
                        }
                    }
                }

                // Step 4: network
                if Creation.step == 3: HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: 22px;
                        padding-right: 24px;
                        spacing: 24px;
                        alignment: start;

                        NetworkFields {
                            deny: Creation.network-deny;
                            allow-local: Creation.network-allow-local;
                            allowed: Creation.allowed;
                            denied: Creation.denied;
                            forwards: Creation.forwards;
                            set-deny(deny) => {
                                Creation.set-network-deny(deny);
                            }
                            set-allow-local(allow) => {
                                Creation.set-network-allow-local(allow);
                            }
                            add-rule(text, deny) => {
                                return Creation.add-rule(text, deny);
                            }
                            toggle-scope(deny, index) => {
                                Creation.toggle-scope(deny, index);
                            }
                            remove-rule(deny, index) => {
                                Creation.remove-rule(deny, index);
                            }
                            add-forward(guest, host) => {
                                return Creation.add-forward(guest, host);
                            }
                            toggle-forward(index) => {
                                Creation.toggle-forward(index);
                            }
                            remove-forward(index) => {
                                Creation.remove-forward(index);
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.line;
                    }

                    VerticalLayout {
                        width: 280px;
                        padding: 24px;
                        padding-right: 0px;
                        spacing: 14px;
                        alignment: start;

                        Text {
                            text: "How rules match";
                            color: Theme.tx2;
                            font-weight: Theme.weight-medium;
                        }

                        Text {
                            text: "github.com matches that exact name. Turn on subdomains to include api.github.com and others.";
                            color: Theme.tx2;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Addresses and ranges, like 203.0.113.7 or 10.0.0.0/8, match the destination directly, without DNS.";
                            color: Theme.tx2;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "When a destination is both allowed and denied, it's denied.";
                            color: Theme.tx2;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Domain rules use DNS results to control destination addresses. A recorded address may be associated with more than one domain.";
                            color: Theme.tx2;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            VerticalLayout {
                                alignment: start;
                                Image {
                                    source: Creation.network-allow-local ? @image-url("icons/alert-triangle.svg") : @image-url("icons/home-off.svg");
                                    colorize: Theme.tx3;
                                    width: 16px;
                                    height: 16px;
                                    accessible-role: none;
                                }
                            }

                            Text {
                                text: Creation.network-allow-local ? "Your Mac and local network follow the rules. Reach services on your Mac at host.internal." : "Your Mac and local network stay unreachable, whatever the rules say.";
                                color: Theme.tx2;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Step 5: review
                if Creation.step == 4: VerticalLayout {
                    if Creation.issues.length > 0: VerticalLayout {
                        padding-top: 22px;
                        spacing: 8px;

                        for issue in Creation.issues: Message {
                            icon: @image-url("icons/alert-circle.svg");
                            color: Theme.bad;
                            text: issue.text;
                            Link {
                                text: "Go to " + root.steps[issue.step];
                                clicked => {
                                    Creation.go(issue.step);
                                }
                            }
                        }
                    }

                    Section {
                        first: Creation.issues.length == 0;
                        title: "Harness";
                        link: "Edit";
                        link-clicked => {
                            Creation.go(0);
                        }

                        KeyValue {
                            key: "Name";
                            value: Creation.name;
                        }

                        KeyValue {
                            key: "Agent";
                            value: Creation.preset-name;
                        }

                        KeyValue {
                            key: "Provisioning";
                            value: Creation.review-script;
                        }
                    }

                    Section {
                        title: "Agent";
                        link: "Edit";
                        link-clicked => {
                            Creation.go(1);
                        }

                        KeyValue {
                            key: "Runs";
                            value: Creation.review-runs;
                            mono: true;
                        }

                        KeyValue {
                            key: "In";
                            value: Creation.working-directory;
                            mono: true;
                        }
                    }

                    Section {
                        title: "Shared folders";
                        link: "Edit";
                        link-clicked => {
                            Creation.go(2);
                        }

                        if Creation.mounts.length == 0: KeyValue {
                            key: "Folders";
                            value: "None. The agent works on the instance's own disk.";
                        }

                        for row in Creation.mounts: HorizontalLayout {
                            spacing: 12px;

                            Text {
                                width: 280px;
                                text: row.host-path + "  →  " + row.guest-path;
                                color: Theme.tx;
                                font-family: Theme.mono;
                                font-size: Theme.font-mono;
                                wrap: word-wrap;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: row.writable ? "Read and write. Changes modify your files immediately." : "Read only";
                                color: row.writable ? Theme.warn : Theme.tx2;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Section {
                        title: "Network";
                        link: "Edit";
                        link-clicked => {
                            Creation.go(3);
                        }

                        KeyValue {
                            key: "Unlisted";
                            value: Creation.network-deny ? "Denied" : "Allowed";
                        }

                        KeyValue {
                            key: "Mac and local network";
                            value: Creation.network-allow-local ? "Allowed" : "Blocked";
                        }

                        KeyValue {
                            key: "Allowed";
                            value: Creation.review-allowed;
                            mono: true;
                        }

                        KeyValue {
                            key: "Denied";
                            value: Creation.review-denied;
                            mono: true;
                        }

                        KeyValue {
                            key: "Forwarded ports";
                            value: Creation.review-forwards;
                            mono: true;
                        }
                    }

                    Section {
                        title: "Environment";
                        link: "Edit";
                        link-clicked => {
                            Creation.go(1);
                        }

                        KeyValue {
                            key: "Variables";
                            value: Creation.review-env;
                            mono: true;
                        }
                    }

                    Section {
                        title: "Resources";
                        description: "The virtual machine's processors, memory and disk. The defaults suit most agents. The instance takes memory and disk space from your Mac only as it uses them.";

                        ResourceFields {
                            cpus <=> Creation.cpus;
                            memory-gb <=> Creation.memory-gb;
                            disk-gb <=> Creation.disk-gb;
                            max-cpus: Creation.max-cpus;
                            max-memory-gb: Creation.max-memory-gb;
                            min-disk-gb: Creation.min-disk-gb;
                            host-line: Creation.host-line;
                            set-cpus(cpus) => {
                                Creation.set-cpus(cpus);
                            }
                            set-memory(gb) => {
                                Creation.set-memory(gb);
                            }
                            set-disk(gb) => {
                                Creation.set-disk(gb);
                            }
                        }
                    }

                    Section {
                        title: "Start";
                        description: "Starting runs the provisioning script first, then the agent.";

                        Text {
                            text: Creation.can-start
                                ? "Create only sets the instance up; start it later from its header. You can change its settings before the first start."
                                : "Fix the problems listed above to start the instance right away. Until then, you can create it without starting.";
                            color: Theme.tx2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // Footer
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            AppButton {
                kind: ButtonKind.ghost;
                text: "Cancel";
                clicked => {
                    Creation.cancel();
                }
            }

            Text {
                horizontal-stretch: 1;
                text: Creation.create-error;
                color: Theme.bad;
                font-size: Theme.font-small;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            if Creation.step > 0: AppButton {
                kind: ButtonKind.ghost;
                text: "Back";
                icon: @image-url("icons/chevron-left.svg");
                clicked => {
                    Creation.go(Creation.step - 1);
                }
            }

            if Creation.step < 4: AppButton {
                kind: ButtonKind.primary;
                text: "Continue to " + root.next-steps[Creation.step];
                clicked => {
                    Creation.go(Creation.step + 1);
                }
            }

            if Creation.step == 4: AppButton {
                kind: ButtonKind.neutral;
                enabled: Creation.can-create;
                text: "Create";
                clicked => {
                    Creation.create(false);
                }
            }

            if Creation.step == 4: AppButton {
                kind: ButtonKind.primary;
                enabled: Creation.can-create && Creation.can-start;
                text: "Create and start";
                icon: @image-url("icons/player-play.svg");
                clicked => {
                    Creation.create(true);
                }
            }
        }
    }
}
