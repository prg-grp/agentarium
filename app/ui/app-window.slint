// Main window: sidebar, instance header, tabs. See design/app-shell.md.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tone, InstanceState, InstanceAction, SaveKind, StatusReading, Usage, InstanceItem, TermRun, TermLine, PresetRow, EnvRow, MountRow, LayoutRow, RuleRow, ForwardRow, ForwardItem, CreateIssue, ActivityRow, DetailField, DetailEntry, DetailItem, DetailSection, RunItem, SnapshotItem } from "types.slint";
import { AppButton, ButtonKind } from "widgets.slint";
import { EmptyState } from "empty-state.slint";
import { TerminalSession, TerminalView } from "terminal.slint";
import { StatusTab } from "status.slint";
import { Activity, ActivityTab } from "activity.slint";
import { Creation, CreateInstance } from "create-instance.slint";
import { Deletion, DeleteDialog } from "delete-dialog.slint";
import { Settings, SettingsTab } from "settings.slint";
import { Snapshots, SnapshotsTab } from "snapshots.slint";
import { Updates, UpdateState, VmDefaults, PreferencesView } from "preferences.slint";
import { GuestImage, GuestState, GuestDownloadDialog } from "guest-download.slint";
import { LicensesWindow, LicenseGroup, LicensedCrate } from "licenses.slint";

export { Tone, InstanceState, InstanceAction, SaveKind, StatusReading, Usage, InstanceItem, TermRun, TermLine, TerminalSession, PresetRow, EnvRow, MountRow, LayoutRow, RuleRow, ForwardRow, ForwardItem, CreateIssue, Creation, Deletion, Settings, Activity, ActivityRow, DetailField, DetailEntry, RunItem, DetailItem, DetailSection, GuestImage, GuestState, Updates, UpdateState, VmDefaults, Snapshots, SnapshotItem, LicensesWindow, LicenseGroup, LicensedCrate }

export component AppWindow inherits Window {
    in property <[InstanceItem]> instances;
    // -1 while the creation screen shows a draft that has no sidebar row yet.
    in-out property <int> selected-index: 0;
    in-out property <int> current-tab: 0;
    // A new instance is being drafted; its screen shows while its row (or no row) is selected.
    in-out property <bool> creating;
    // The Preferences view replaces the instance screens until an instance is picked.
    in-out property <bool> show-preferences;

    callback create-instance();
    callback instance-action(string, InstanceAction);
    // The selected instance changed; its terminal is shown.
    callback instance-selected(string);
    // The tab changed; the Agent, Terminal and Logs tabs show different terminals.
    callback tab-changed(int);
    // The instance's logs folder should open in Finder.
    callback open-logs(string);
    // The Terminal tab's "New shell" was clicked: open a shell in the instance.
    callback new-shell(string);
    // The third-party licenses window should open.
    // A forwarded port's chip in the terminal's header was clicked.
    callback open-url(string);
    callback open-licenses();
    callback drag-window();
    // A sidebar row was dragged from one index to another; `to` is its index after the move.
    callback move-instance(from: int, to: int);

    property <InstanceItem> current: instances[selected-index];
    property <string> current-id: current.id;
    changed current-id => {
        root.instance-selected(current-id);
    }
    changed current-tab => {
        root.tab-changed(current-tab);
    }
    property <bool> in-maintenance: current.state == InstanceState.maintenance;
    property <bool> show-creation: creating && (selected-index < 0 || current.state == InstanceState.draft);

    // While a sidebar row is dragged by its grip: its index (-1 otherwise), the pointer's y in
    // window coordinates, the row under the pointer, and the slot (0 to the count) it would go to.
    property <int> drag-from: -1;
    property <length> pointer-y;
    property <int> drop-row: -1;
    property <int> drop-slot: -1;
    property <bool> pointer-inside: root.pointer-y >= list.absolute-position.y && root.pointer-y < list.absolute-position.y + list.height;
    // Dropping now would change the order.
    property <bool> drop-moves: root.drag-from >= 0 && root.pointer-inside && root.drop-slot >= 0 && root.drop-slot != root.drag-from && root.drop-slot != root.drag-from + 1;

    function end-drag(drop: bool) {
        if drop && root.drop-moves {
            root.move-instance(root.drag-from, root.drop-slot > root.drag-from ? root.drop-slot - 1 : root.drop-slot);
        }
        root.drag-from = -1;
        root.drop-row = -1;
        root.drop-slot = -1;
    }

    pure function state-icon(state: InstanceState) -> image {
        if state == InstanceState.maintenance {
            return @image-url("icons/tool.svg");
        }
        if state == InstanceState.startup-failed {
            return @image-url("icons/alert-triangle.svg");
        }
        if state == InstanceState.agent-exited {
            return @image-url("icons/square-x.svg");
        }
        if state == InstanceState.stopped {
            return @image-url("icons/circle.svg");
        }
        if state == InstanceState.draft {
            return @image-url("icons/pencil.svg");
        }
        return @image-url("icons/circle-dot.svg");
    }

    pure function state-color(state: InstanceState) -> color {
        if state == InstanceState.running {
            return Theme.ok;
        }
        if state == InstanceState.maintenance {
            return Theme.warn;
        }
        if state == InstanceState.startup-failed {
            return Theme.bad;
        }
        if state == InstanceState.draft {
            return Theme.acc;
        }
        if state == InstanceState.agent-exited {
            return Theme.tx2;
        }
        return Theme.tx3;
    }

    title: "Agentarium";
    icon: @image-url("app-icon.png");
    background: Theme.bg;
    default-font-size: Theme.font-body;
    min-width: 1100px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 800px;

    // Lets the window be moved by its top edge, since the title bar is transparent on macOS.
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: 28px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-window();
            }
        }
    }

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.panel;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-top: 38px;

                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 14px;
                    padding-bottom: 10px;

                    Text {
                        text: "Instances";
                        color: Theme.tx2;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                    }

                    AppButton {
                        kind: ButtonKind.ghost;
                        compact: true;
                        icon: @image-url("icons/plus.svg");
                        label: "New instance";
                        clicked => {
                            root.show-preferences = false;
                            root.create-instance();
                        }
                    }
                }

                if instances.length == 0: HorizontalLayout {
                    padding-left: 22px;
                    padding-top: 6px;
                    Text {
                        text: "No instances yet";
                        color: Theme.tx3;
                        font-size: Theme.font-small;
                    }
                }

                list := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;

                    // Near the list's top or bottom edge, a drag scrolls the list.
                    property <length> edge: 24px;
                    property <bool> near-top: root.pointer-y < self.absolute-position.y + self.edge;
                    property <bool> near-bottom: root.pointer-y > self.absolute-position.y + self.height - self.edge;

                    Timer {
                        interval: 16ms;
                        running: root.drag-from >= 0 && (list.near-top || list.near-bottom);
                        triggered => {
                            list.content-y = clamp(list.content-y + (list.near-top ? 6px : -6px), min(0px, list.visible-height - list.content-height), 0px);
                        }
                    }

                    VerticalLayout {
                        alignment: start;
                        // Room for the drop marker above the first row and below the last.
                        padding-top: 2px;
                        padding-bottom: 2px;

                        for item[index] in instances: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            vertical-stretch: 0;

                            Rectangle {
                                property <bool> selected: index == root.selected-index && !root.show-preferences;
                                // The draft has no stored order: it can't be dragged, nor anything above it.
                                property <bool> draft: item.state == InstanceState.draft;
                                property <bool> dragged: root.drag-from == index;
                                property <bool> hovered: item-touch.has-hover || grip.has-hover;
                                // Widened by half the gap, so the gaps between rows count too.
                                property <bool> under-pointer: root.drag-from >= 0 && !self.draft && root.pointer-y >= self.absolute-position.y - 2px && root.pointer-y < self.absolute-position.y + self.height + 2px;
                                property <bool> lower-half: root.pointer-y >= self.absolute-position.y + self.height / 2;

                                function aim() {
                                    if self.under-pointer {
                                        root.drop-row = index;
                                        root.drop-slot = self.lower-half ? index + 1 : index;
                                    }
                                }
                                changed under-pointer => {
                                    self.aim();
                                }
                                changed lower-half => {
                                    self.aim();
                                }

                                accessible-role: list-item;
                                accessible-label: item.name;
                                accessible-description: item.summary;
                                accessible-item-selected: selected;

                                // Clipped, so the selection bar follows the rounded corners; the drop
                                // marker sits outside it.
                                Rectangle {
                                    border-radius: Theme.radius-item;
                                    clip: true;
                                    background: dragged ? Theme.acc.transparentize(85%) : selected ? Theme.raise : (hovered && root.drag-from < 0 ? Theme.hover : transparent);
                                    border-width: dragged ? 1px : 0px;
                                    border-color: Theme.acc;

                                    Rectangle {
                                        x: 0;
                                        width: 2px;
                                        visible: selected && !dragged;
                                        background: item.state == InstanceState.maintenance ? Theme.warn : Theme.acc;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    // Room for the grip.
                                    padding-right: 26px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: 2px;
                                        Image {
                                            source: root.state-icon(item.state);
                                            colorize: root.state-color(item.state);
                                            width: 16px;
                                            height: 16px;
                                            accessible-role: none;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 3px;
                                        Text {
                                            text: item.name;
                                            color: Theme.tx;
                                            font-weight: selected ? Theme.weight-medium : Theme.weight-regular;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.summary;
                                            font-size: Theme.font-meta;
                                            color: item.state == InstanceState.running ? Theme.tx2 : root.state-color(item.state);
                                            overflow: elide;
                                        }
                                    }
                                }

                                item-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-preferences = false;
                                        root.selected-index = index;
                                        root.current-tab = 0;
                                    }
                                }

                                // Only the grip starts a drag, so the row stays clickable. It keeps the
                                // mouse until release, and with it the cursor.
                                grip := TouchArea {
                                    x: parent.width - self.width - 6px;
                                    width: 16px;
                                    enabled: !draft;
                                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                    moved => {
                                        if self.pressed {
                                            root.drag-from = index;
                                            root.pointer-y = self.absolute-position.y + self.mouse-y;
                                        }
                                    }
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.up {
                                            root.end-drag(true);
                                        } else if event.kind == PointerEventKind.cancel {
                                            root.end-drag(false);
                                        }
                                    }

                                    Image {
                                        x: 1px;
                                        y: (parent.height - self.height) / 2;
                                        width: 14px;
                                        height: 14px;
                                        visible: !draft && (hovered || dragged);
                                        source: @image-url("icons/grip-vertical.svg");
                                        colorize: Theme.tx3;
                                        accessible-role: none;
                                    }
                                }

                                // Where the dragged row would land: above or below this row.
                                if root.drop-moves && root.drop-row == index && (root.drop-slot == index || root.drop-slot == index + 1): Rectangle {
                                    x: 0;
                                    y: root.drop-slot == index ? -3px : parent.height + 1px;
                                    width: parent.width;
                                    height: 2px;
                                    border-radius: 1px;
                                    background: Theme.acc;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 48px;
                    background: root.show-preferences ? Theme.raise : (preferences-touch.has-hover ? Theme.hover : transparent);
                    accessible-role: button;
                    accessible-label: "Preferences";
                    accessible-description: Updates.state == UpdateState.ready ? "Update ready" : "";
                    accessible-action-default => {
                        root.show-preferences = true;
                    }

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 18px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/adjustments-horizontal.svg");
                                colorize: root.show-preferences ? Theme.tx : Theme.tx2;
                                width: 16px;
                                height: 16px;
                                accessible-role: none;
                            }
                        }

                        Text {
                            text: "Preferences";
                            color: root.show-preferences ? Theme.tx : Theme.tx2;
                            font-weight: root.show-preferences ? Theme.weight-medium : Theme.weight-regular;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if Updates.state == UpdateState.ready: Text {
                            text: "Update ready";
                            color: Theme.acc;
                            font-size: Theme.font-meta;
                            vertical-alignment: center;
                        }
                    }

                    preferences-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-preferences = true;
                        }
                    }
                }
            }
        }

        // Main area
        Rectangle {
            horizontal-stretch: 1;

            if show-preferences: PreferencesView {
                width: parent.width;
                height: parent.height;
                open-licenses => {
                    root.open-licenses();
                }
            }

            if !show-preferences && show-creation: CreateInstance {
                width: parent.width;
                height: parent.height;
            }

            if !show-preferences && instances.length == 0 && !creating: EmptyState {
                width: parent.width;
                height: parent.height;
                create => {
                    root.create-instance();
                }
            }

            if !show-preferences && instances.length > 0 && !show-creation: VerticalLayout {
                width: parent.width;
                height: parent.height;

                // Instance header
                HorizontalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 26px;
                    padding-bottom: 24px;

                    VerticalLayout {
                        alignment: center;
                        padding-right: 24px;
                        horizontal-stretch: 0;

                        Text {
                            text: current.name;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-medium;
                            color: Theme.tx;
                        }

                        Text {
                            text: current.agent;
                            color: Theme.tx2;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;

                        HorizontalLayout {
                            spacing: 10px;

                            if current.state == InstanceState.running || current.state == InstanceState.agent-exited || current.state == InstanceState.startup-failed: AppButton {
                                kind: ButtonKind.ghost;
                                text: "Restart in maintenance";
                                icon: @image-url("icons/tool.svg");
                                enabled: current.transition == "";
                                clicked => {
                                    root.instance-action(current.id, InstanceAction.restart-maintenance);
                                }
                            }

                            if in-maintenance: AppButton {
                                kind: ButtonKind.ghost;
                                text: "Restart in agent mode";
                                icon: @image-url("icons/sparkles.svg");
                                enabled: current.transition == "";
                                clicked => {
                                    root.instance-action(current.id, InstanceAction.restart-agent);
                                }
                            }

                            if current.state == InstanceState.stopped: AppButton {
                                kind: ButtonKind.ghost;
                                text: "Boot in maintenance";
                                icon: @image-url("icons/tool.svg");
                                clicked => {
                                    root.instance-action(current.id, InstanceAction.boot-maintenance);
                                }
                            }

                            if current.state != InstanceState.stopped && current.state != InstanceState.draft: AppButton {
                                kind: ButtonKind.neutral;
                                text: "Stop";
                                icon: @image-url("icons/player-stop.svg");
                                clicked => {
                                    root.instance-action(current.id, InstanceAction.stop);
                                }
                            }

                            if current.state == InstanceState.stopped: AppButton {
                                kind: ButtonKind.primary;
                                text: "Start";
                                icon: @image-url("icons/player-play.svg");
                                clicked => {
                                    root.instance-action(current.id, InstanceAction.start);
                                }
                            }

                            if current.state != InstanceState.draft: HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 14px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 1px;
                                        height: 22px;
                                        background: Theme.line2;
                                    }
                                }

                                AppButton {
                                    kind: ButtonKind.danger;
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    clicked => {
                                        root.instance-action(current.id, InstanceAction.delete);
                                    }
                                }
                            }
                        }
                    }
                }

                // Tabs
                Rectangle {
                    height: 44px;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 28px;
                        spacing: 28px;
                        alignment: start;

                        for tab-name[tab-index] in ["Agent", "Terminal", "Activity", "Status", "Logs", "Snapshots", "Settings"]: Rectangle {
                            property <bool> active: tab-index == root.current-tab;

                            accessible-role: tab;
                            accessible-label: tab-name;
                            accessible-item-selected: active;

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: tab-name;
                                    color: active ? Theme.tx : Theme.tx2;
                                    font-weight: active ? Theme.weight-medium : Theme.weight-regular;
                                    vertical-alignment: center;
                                }

                            }

                            Rectangle {
                                y: parent.height - 2px;
                                height: 2px;
                                visible: active;
                                background: in-maintenance ? Theme.warn : Theme.acc;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.current-tab = tab-index;
                                }
                            }
                        }
                    }
                }

                // Tab content (other screens come in later steps)
                if current-tab == 0 && current.has-terminal: TerminalView {
                    vertical-stretch: 1;
                    transition: current.transition;
                    forwards: current.forwards;
                    open-url(url) => {
                        root.open-url(url);
                    }
                    open-log => {
                        root.current-tab = 4;
                    }
                }

                // A login shell beside the agent, while it runs.
                if current-tab == 1 && current.has-terminal: TerminalView {
                    vertical-stretch: 1;
                    shell: true;
                    transition: current.transition;
                    can-start-shell: (current.state == InstanceState.running || current.state == InstanceState.agent-exited) && current.transition == "";
                    new-shell => {
                        root.new-shell(current.id);
                    }
                }

                if current-tab == 2: ActivityTab {
                    vertical-stretch: 1;
                }

                if current-tab == 3: StatusTab {
                    vertical-stretch: 1;
                    item: current;
                }

                // The boot log: the same view, read-only.
                if current-tab == 4 && current.has-terminal: TerminalView {
                    vertical-stretch: 1;
                    log: true;
                    open-logs => {
                        root.open-logs(current.id);
                    }
                }

                if current-tab == 5: SnapshotsTab {
                    vertical-stretch: 1;
                    item: current;
                }

                if current-tab == 6: SettingsTab {
                    vertical-stretch: 1;
                    item: current;
                }

                if (current-tab <= 1 || current-tab == 4) && !current.has-terminal: Rectangle {
                    vertical-stretch: 1;

                    Text {
                        text: current-tab == 4 ? "Logs come in a later step."
                            : "Terminal comes in a later step.";
                        color: Theme.tx3;
                        font-size: Theme.font-small;
                    }
                }
            }
        }
    }

    // Covers the whole window, sidebar included.
    if Deletion.open: DeleteDialog {
        width: parent.width;
        height: parent.height;
    }

    // Blocks the whole app until this build's guest image is downloaded.
    if GuestImage.state != GuestState.ready: GuestDownloadDialog {
        width: parent.width;
        height: parent.height;
        drag-window => {
            root.drag-window();
        }
    }
}
