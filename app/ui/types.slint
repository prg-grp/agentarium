// Data types shared between Rust and the UI. Re-exported from app-window.slint.

export enum Tone { ok, warn, bad, neutral, muted, accent }

export enum InstanceState { running, agent-exited, maintenance, startup-failed, stopped, draft }

export enum InstanceAction { start, stop, boot-maintenance, restart-maintenance, restart-agent, delete }

// A preset offered on the Harness step, in the order of Preset::ALL (src/preset.rs).
export struct PresetRow {
    name: string,
    note: string,
}

export struct StatusReading {
    value: string,
    tone: Tone,
}

// The resource use the guest supervisor last reported, for the Status tab (src/controller.rs).
// Fractions are 0 to 1, of all vCPUs or of the guest's memory. Nothing is stored.
export struct Usage {
    // Shown instead of the meters when there is nothing to report; "" when there is.
    note: string,
    // False while reports are overdue.
    live: bool,
    // Whether the agent's own use is measured (its cgroup could be set up).
    measured: bool,
    agent-cpu: float,
    vm-cpu: float,
    cpu-text: string,
    agent-memory: float,
    vm-memory: float,
    memory-text: string,
    // The guest's memory is almost full, or the agent ran out of memory.
    memory-warning: bool,
    restarts: int,
    last-exit: string,
    oom-kills: int,
}

export struct InstanceItem {
    id: string,
    name: string,
    agent: string,
    state: InstanceState,
    summary: string,
    vm: StatusReading,
    agent-status: StatusReading,
    monitoring: StatusReading,
    usage: Usage,
    // Whether a provisioning run succeeded; Settings opens only then.
    provisioned: bool,
    // The newest booted revision and the latest saved one; pending-changes counts the
    // changes between them (src/settings.rs).
    active-revision: int,
    saved-revision: int,
    pending-changes: int,
    has-terminal: bool,
    // Label of the start, stop or restart in progress, shown over the terminal; "" when none.
    transition: string,
}

// One styled stretch of terminal text, starting at column `col`.
export struct TermRun {
    col: int,
    width: int,
    text: string,
    fg: color,
    bg: color,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct TermLine {
    runs: [TermRun],
}

// Selected cells on one visible row.
export struct TermSpan {
    row: int,
    col: int,
    width: int,
}

// Rows of the creation flow (src/create.rs). Messages are "" when there is nothing to say.
export struct EnvRow {
    name: string,
    value: string,
    error: string,
}

export struct MountRow {
    host-path: string,
    guest-path: string,
    writable: bool,
    missing: bool,
    problem: string,
    guest-error: string,
}

// One line of what the instance sees: ~/workspace on its disk, or a shared folder.
// A nested folder's path is relative to the line it's nested in.
export struct LayoutRow {
    path: string,
    depth: int,
    source: string,
    shared: bool,
}

export struct RuleRow {
    target: string,
    scope: string,
    is-domain: bool,
    conflict: string,
}

// Keeps the draft from starting, or with blocks-create from being created at all.
export struct CreateIssue {
    step: int,
    text: string,
    blocks-create: bool,
}

// The Activity tab (src/activity.rs, src/activity_data.rs).

// One row of an Activity view. Headings group rows (an area, the destinations); depth
// indents rows inside an expanded command.
export struct ActivityRow {
    key: string,
    depth: int,
    heading: bool,
    expandable: bool,
    expanded: bool,
    time: string,
    // A short type ("File", "DNS"), in All events only.
    label: string,
    title: string,
    subtitle: string,
    subtitle-tone: Tone,
    // The processes behind the row, e.g. "claude, curl".
    meta: string,
    result: string,
    tone: Tone,
    // De-emphasized, e.g. reads.
    dim: bool,
}

export struct DetailField {
    label: string,
    value: string,
    mono: bool,
}

export struct DetailEntry {
    time: string,
    text: string,
    tone: Tone,
}

// One line of a detail page's section; `key` names the page it opens, or is "".
export struct DetailItem {
    depth: int,
    text: string,
    detail: string,
    tone: Tone,
    key: string,
    mono: bool,
}

export struct DetailSection {
    title: string,
    note: string,
    items: [DetailItem],
}

// An agent run in the run picker.
export struct RunItem {
    title: string,
    detail: string,
    live: bool,
}
