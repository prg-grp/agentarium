// Agent terminal and boot log, see design/terminal-running.md and design/app-shell.md.

import { Theme } from "theme.slint";
import { TermLine, TermSpan } from "types.slint";
import { AppButton, ButtonKind } from "widgets.slint";

// State of the running terminal session, written from Rust (src/terminal.rs).
export global TerminalSession {
    in property <[TermLine]> lines;
    in property <int> cursor-row;
    in property <int> cursor-col;
    in property <bool> cursor-visible: true;
    in property <bool> exited;
    // Shown in the exit bar when no session is attached.
    in property <string> exit-message;
    // Lines scrolled back from the latest output.
    in property <int> scroll-offset;
    // Lines of output above the screen, i.e. the largest scroll-offset.
    in property <int> history-size;
    in property <string> cwd-label: "~";
    // Highlighted cells of the current mouse selection.
    in property <[TermSpan]> selection;

    // Raw key event; Rust maps it to bytes. Returns whether the key was used.
    callback key(text: string, control: bool, alt: bool, meta: bool, shift: bool) -> bool;
    callback resized(cols: int, rows: int);
    // Positive values scroll back into older output.
    callback scrolled(lines: int);
    // Scrolls to an absolute offset; 0 is the latest output.
    callback scroll-to(offset: int);
    callback jump-to-latest();
    // Mouse position in cell units; the fraction tells which half of the cell.
    callback select-start(col: float, row: float);
    callback select-update(col: float, row: float);
}

export component TerminalView {
    // Shows the read-only boot log instead of the session. Rust ignores its input, except
    // for selecting and copying.
    in property <bool> log;
    // Label of the start, stop or restart in progress; "" when none. The session is covered
    // and takes no input meanwhile. The boot log stays visible, since it shows the progress.
    in property <string> transition;
    property <bool> busy: !log && transition != "";
    // The "Boot log" link in the session's header was clicked.
    callback open-log();
    // The boot log's "Open logs" button was clicked.
    callback open-logs();

    init => {
        focus.focus();
    }

    VerticalLayout {
        Rectangle {
            height: 36px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 4px;

                if !root.log: Text {
                    text: "Agent session in";
                    color: Theme.tx3;
                    font-size: Theme.font-meta;
                    vertical-alignment: center;
                }

                if !root.log: Text {
                    text: TerminalSession.cwd-label;
                    color: Theme.tx2;
                    font-family: Theme.mono;
                    font-size: Theme.font-meta;
                    vertical-alignment: center;
                }

                if root.log: Text {
                    text: "Boot log";
                    color: Theme.tx2;
                    font-weight: Theme.weight-medium;
                    font-size: Theme.font-meta;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.log: Text {
                    text: "Serial console, not the agent session";
                    color: Theme.tx3;
                    font-size: Theme.font-meta;
                    vertical-alignment: center;
                }

                if root.log: AppButton {
                    text: "Open logs";
                    icon: @image-url("icons/folder.svg");
                    kind: ButtonKind.ghost;
                    compact: true;
                    clicked => {
                        root.open-logs();
                    }
                }

                if !root.log: Text {
                    text: "Boot log";
                    color: link-touch.has-hover ? Theme.tx2 : Theme.tx3;
                    font-size: Theme.font-meta;
                    vertical-alignment: center;
                    accessible-role: button;
                    accessible-action-default => {
                        root.open-log();
                    }

                    link-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-log();
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.well;

            // 100 glyphs, so the rounded measured width doesn't drift the
            // cursor away from the text over many columns.
            measure := Text {
                text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
                font-family: Theme.mono;
                font-size: Theme.font-mono;
                visible: false;
            }

            grid := Rectangle {
                property <length> cell-width: measure.preferred-width / 100;
                property <length> cell-height: measure.preferred-height;
                property <int> cols: cell-width > 0 ? max(2, floor(self.width / cell-width)) : 80;
                property <int> rows: cell-height > 0 ? max(1, floor(self.height / cell-height)) : 24;
                property <length> scroll-rest;

                x: 22px;
                y: 18px;
                width: parent.width - 44px;
                height: parent.height - 36px;
                clip: true;

                init => {
                    TerminalSession.resized(self.cols, self.rows);
                }
                changed cols => {
                    TerminalSession.resized(self.cols, self.rows);
                }
                changed rows => {
                    TerminalSession.resized(self.cols, self.rows);
                }

                focus := FocusScope {
                    key-pressed(event) => {
                        if root.busy {
                            return accept;
                        }
                        if TerminalSession.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.meta, event.modifiers.shift) {
                            return accept;
                        }
                        return reject;
                    }
                }

                for line[row] in TerminalSession.lines: Rectangle {
                    x: 0;
                    y: row * grid.cell-height;
                    width: grid.width;
                    height: grid.cell-height;

                    for run in line.runs: Rectangle {
                        x: run.col * grid.cell-width;
                        y: 0;
                        width: run.width * grid.cell-width;
                        height: grid.cell-height;
                        background: run.bg;

                        Text {
                            x: 0;
                            y: 0;
                            text: run.text;
                            color: run.fg;
                            font-family: Theme.mono;
                            font-size: Theme.font-mono;
                            font-weight: run.bold ? 700 : 400;
                            font-italic: run.italic;
                        }

                        if run.underline: Rectangle {
                            y: parent.height - 2px;
                            height: 1px;
                            background: run.fg;
                        }
                    }
                }

                for span in TerminalSession.selection: Rectangle {
                    x: span.col * grid.cell-width;
                    y: span.row * grid.cell-height;
                    width: span.width * grid.cell-width;
                    height: grid.cell-height;
                    background: Theme.acc.with-alpha(0.3);
                }

                if !root.log && !root.busy && TerminalSession.cursor-visible && TerminalSession.scroll-offset == 0 && !TerminalSession.exited: Rectangle {
                    x: TerminalSession.cursor-col * grid.cell-width;
                    y: TerminalSession.cursor-row * grid.cell-height;
                    width: grid.cell-width;
                    height: grid.cell-height;
                    background: focus.has-focus ? Theme.terminal-fg.with-alpha(0.7) : transparent;
                    border-width: focus.has-focus ? 0px : 1px;
                    border-color: Theme.terminal-fg;
                }

                TouchArea {
                    mouse-cursor: text;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            focus.focus();
                            // Shift+click extends the selection, also after scrolling.
                            if event.modifiers.shift {
                                TerminalSession.select-update(self.mouse-x / grid.cell-width, self.mouse-y / grid.cell-height);
                            } else {
                                TerminalSession.select-start(self.mouse-x / grid.cell-width, self.mouse-y / grid.cell-height);
                            }
                        }
                    }
                    moved => {
                        if self.pressed {
                            TerminalSession.select-update(self.mouse-x / grid.cell-width, self.mouse-y / grid.cell-height);
                        }
                    }
                    scroll-event(event) => {
                        grid.scroll-rest += event.delta-y;
                        if grid.scroll-rest >= grid.cell-height || grid.scroll-rest <= -grid.cell-height {
                            let lines = grid.scroll-rest > 0 ? floor(grid.scroll-rest / grid.cell-height) : -floor(-grid.scroll-rest / grid.cell-height);
                            grid.scroll-rest -= lines * grid.cell-height;
                            TerminalSession.scrolled(lines);
                            // Keep the selection end under the pointer while dragging.
                            if self.pressed {
                                TerminalSession.select-update(self.mouse-x / grid.cell-width, self.mouse-y / grid.cell-height);
                            }
                        }
                        return accept;
                    }
                }
            }

            if TerminalSession.scroll-offset > 0: AppButton {
                x: parent.width - self.width - 22px;
                y: parent.height - self.height - 16px;
                kind: ButtonKind.neutral;
                compact: true;
                text: "Jump to latest";
                clicked => {
                    TerminalSession.jump-to-latest();
                    focus.focus();
                }
            }

            // Scrollbar over the history, in the right gutter. Hidden without history, e.g.
            // on the alternate screen of full-screen apps. Clicking the track jumps there.
            if TerminalSession.history-size > 0: bar := Rectangle {
                property <length> thumb-height: max(28px, self.height * grid.rows / (grid.rows + TerminalSession.history-size));
                property <length> thumb-y: (self.height - self.thumb-height) * (1 - TerminalSession.scroll-offset / TerminalSession.history-size);
                // Pointer position within the thumb while dragging.
                property <length> grab;

                x: parent.width - 16px;
                y: 18px;
                width: 14px;
                height: parent.height - 36px;

                function drag-to(pointer-y: length) {
                    let fraction = max(0, min(1, (pointer-y - self.grab) / max(1px, self.height - self.thumb-height)));
                    TerminalSession.scroll-to(round((1 - fraction) * TerminalSession.history-size));
                }

                Rectangle {
                    x: 4px;
                    width: 6px;
                    border-radius: 3px;
                    background: bar-touch.has-hover || bar-touch.pressed ? Theme.line.with-alpha(0.6) : transparent;

                    Rectangle {
                        y: bar.thumb-y;
                        height: bar.thumb-height;
                        border-radius: 3px;
                        background: Theme.tx3.with-alpha(bar-touch.has-hover || bar-touch.pressed ? 0.7 : 0.35);
                    }
                }

                bar-touch := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            if self.mouse-y >= bar.thumb-y && self.mouse-y < bar.thumb-y + bar.thumb-height {
                                bar.grab = self.mouse-y - bar.thumb-y;
                            } else {
                                bar.grab = bar.thumb-height / 2;
                                bar.drag-to(self.mouse-y);
                            }
                        }
                        if event.kind == PointerEventKind.up {
                            focus.focus();
                        }
                    }
                    moved => {
                        if self.pressed {
                            bar.drag-to(self.mouse-y);
                        }
                    }
                }
            }

            if root.busy: Rectangle {
                background: Theme.well.with-alpha(0.5);

                // Swallows clicks, selection and scrolling meant for the session below.
                TouchArea {
                    scroll-event(event) => {
                        return accept;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        // A quarter arc on a faint ring, one turn per second.
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: self.width / 2;
                            border-width: 2.5px;
                            border-color: Theme.tx3.with-alpha(0.3);

                            Path {
                                width: 100%;
                                height: 100%;
                                viewbox-width: 28;
                                viewbox-height: 28;
                                commands: "M 14 1.25 A 12.75 12.75 0 0 1 26.75 14";
                                stroke: Theme.tx2;
                                stroke-width: 2.5px;
                                transform-rotation: (animation-tick() / 1ms).mod(1000) * 0.36deg;
                            }
                        }
                    }

                    Text {
                        text: root.transition;
                        color: Theme.tx2;
                        font-size: Theme.font-meta;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if TerminalSession.exited: Rectangle {
            height: 64px;
            background: Theme.panel;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line2;
            }

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 14px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("icons/square-x.svg");
                        colorize: Theme.tx2;
                        width: 18px;
                        height: 18px;
                        accessible-role: none;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: TerminalSession.exit-message;
                        color: Theme.tx;
                    }

                    Text {
                        text: "Output above is kept until the next start.";
                        color: Theme.tx3;
                        font-size: Theme.font-small;
                    }
                }
            }
        }
    }
}
