// Preferences: app updates, snapshots, the guest image and the licenses. See design/preferences.md.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppButton, ButtonKind, SegmentedControl, ProgressBar } from "widgets.slint";
import { Message } from "config-fields.slint";
import { Group } from "settings.slint";
import { GuestImage } from "guest-download.slint";
import { Snapshots } from "snapshots.slint";

export enum UpdateState { unavailable, checking, up-to-date, downloading, ready, failed }

// Updates of the app itself. Rust (src/update.rs) owns it.
export global Updates {
    in property <string> version;
    // 0: stable releases, 1: dev builds.
    in property <int> channel;
    in property <UpdateState> state: UpdateState.checking;
    in property <string> status;
    in property <float> progress;
    // The version being downloaded or waiting for the restart, and its release notes.
    in property <string> available;
    in property <string> notes;
    callback set-channel(int);
    callback check();
    // Shuts the running instances down, then installs the update and relaunches.
    callback restart();
}

// A label on the left, its value or control on the right.
component Row {
    in property <string> label;

    HorizontalLayout {
        spacing: 16px;

        Text {
            width: 120px;
            text: root.label;
            color: Theme.tx2;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }

        @children
    }
}

export component PreferencesView {
    callback open-licenses();

    VerticalLayout {
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 26px;
            padding-bottom: 24px;

            Text {
                text: "Preferences";
                font-size: Theme.font-title;
                font-weight: Theme.weight-medium;
                color: Theme.tx;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-bottom: 28px;
                alignment: start;

                Group {
                    first: true;
                    title: "Updates";
                    description: "Agentarium checks for new versions every few hours and downloads them in the background.";

                    Row {
                        label: "Version";
                        Text {
                            text: Updates.version;
                            font-family: Theme.mono;
                            font-size: Theme.font-mono;
                            color: Theme.tx;
                            vertical-alignment: center;
                        }
                    }

                    Row {
                        label: "Channel";
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            HorizontalLayout {
                                alignment: start;
                                SegmentedControl {
                                    options: ["Stable", "Dev builds"];
                                    selected: Updates.channel;
                                    changed(index) => {
                                        Updates.set-channel(index);
                                    }
                                }
                            }

                            Text {
                                text: Updates.channel == 1
                                    ? "Every change to Agentarium as soon as it's built, and every release. Dev builds can have rough edges."
                                    : "Releases only.";
                                color: Theme.tx3;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Row {
                        label: "Status";
                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            if Updates.state == UpdateState.failed: Message {
                                icon: @image-url("icons/alert-triangle.svg");
                                text: Updates.status;
                                color: Theme.bad;
                            }

                            if Updates.state == UpdateState.ready: Message {
                                icon: @image-url("icons/circle-check.svg");
                                text: Updates.status;
                                color: Theme.ok;
                            }

                            if Updates.state != UpdateState.failed && Updates.state != UpdateState.ready: Text {
                                text: Updates.status;
                                color: Theme.tx2;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }

                            if Updates.state == UpdateState.downloading: ProgressBar {
                                progress: Updates.progress;
                                label: Updates.status;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        if Updates.state == UpdateState.ready: AppButton {
                            kind: ButtonKind.primary;
                            text: "Restart to update";
                            icon: @image-url("icons/refresh.svg");
                            clicked => {
                                Updates.restart();
                            }
                        }

                        if Updates.state != UpdateState.unavailable && Updates.state != UpdateState.ready: AppButton {
                            kind: ButtonKind.neutral;
                            text: "Check now";
                            enabled: Updates.state == UpdateState.up-to-date || Updates.state == UpdateState.failed;
                            clicked => {
                                Updates.check();
                            }
                        }

                        if Updates.state == UpdateState.ready: Text {
                            text: "Running instances shut down first.";
                            color: Theme.tx3;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }

                    if (Updates.state == UpdateState.ready || Updates.state == UpdateState.downloading) && Updates.notes != "": VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "What's new in \{Updates.available}";
                            color: Theme.tx;
                            font-weight: Theme.weight-medium;
                        }

                        Text {
                            text: Updates.notes;
                            color: Theme.tx2;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                    }
                }

                Group {
                    title: "Snapshots";
                    description: "A snapshot keeps an instance's disk and configuration, so you can return to it from the instance's Snapshots tab.";

                    Row {
                        label: "After provisioning";
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            HorizontalLayout {
                                alignment: start;
                                SegmentedControl {
                                    options: ["On", "Off"];
                                    selected: Snapshots.auto-snapshot ? 0 : 1;
                                    changed(index) => {
                                        Snapshots.set-auto-snapshot(index == 0);
                                    }
                                }
                            }

                            Text {
                                text: Snapshots.auto-snapshot
                                    ? "New instances get a snapshot named \"Freshly provisioned\" once provisioning succeeds, so you can reset them later."
                                    : "No snapshot is taken automatically.";
                                color: Theme.tx3;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Group {
                    title: "Guest image";
                    description: "The Linux kernel and root filesystem that new instances start from. Existing instances keep the one they were created with.";

                    Row {
                        label: "Source";
                        Text {
                            text: GuestImage.source;
                            color: Theme.tx;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }

                    Row {
                        label: "Status";
                        Text {
                            text: "Ready";
                            color: Theme.tx2;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                }

                Group {
                    title: "About";
                    description: "Agentarium is free software under the GNU Affero General Public License v3.0 or later. It's built on open-source crates, each under its own license.";

                    Row {
                        label: "License";
                        Text {
                            text: "AGPL-3.0-or-later";
                            font-family: Theme.mono;
                            font-size: Theme.font-mono;
                            color: Theme.tx;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: start;

                        AppButton {
                            kind: ButtonKind.neutral;
                            text: "Third-party licenses";
                            clicked => {
                                root.open-licenses();
                            }
                        }
                    }
                }
            }
        }
    }
}
